#!/usr/bin/env bash
# mgr-status — pretty-print the queue state: in-flight workers, queued tasks,
# recent completions.
#
# Usage:
#   mgr-status            # human-readable
#   mgr-status --json     # machine-readable

set -euo pipefail
POD_BIN="$(cd "$(dirname "$0")/../../../bin" && pwd)"; . "$POD_BIN/_pod-paths.sh"
. "$POD_BIN/_mgr-runtime.sh"                       # mgr_current_pod, mgr_pod_auto_state

INBOX_ROOT="$POD_INBOX"
WORKERS_PATH="$POD_STATE/workers.json"
LOG_PATH="$POD_STATE/log.jsonl"

# workers.json is only created when the FIRST worker registers (pod-add-worker), so a
# freshly launched pod does not have one. Read it ONCE into an empty-registry-defaulted
# snapshot rather than pointing jq at the path in three places: jq exits 2 on a missing
# file, and under set -e that killed the report right after the WORKERS banner — which
# is why the "(no workers registered)" hint below could never actually print, and why
# --json emitted a raw jq "Could not open" error instead of an empty board. The registry
# is written atomically (pod-workers-json os.replace), so one cat is a consistent read.
WORKERS_JSON='{"workers":[]}'
if [ -f "$WORKERS_PATH" ]; then
  WORKERS_JSON="$(jq -c '{workers: (.workers // [])}' "$WORKERS_PATH" 2>/dev/null || echo '{"workers":[]}')"
fi

CURRENT_POD="$(mgr_current_pod)"
CURRENT_POD="$(mgr_pod_component "$CURRENT_POD")" || exit 2
QUEUE_DIR="$(mgr_queue_dir "$CURRENT_POD")"
DISPATCHED="$(mgr_dispatched_dir "$CURRENT_POD")"
AUTO_STATE="$(mgr_pod_auto_state "$CURRENT_POD")"   # on | off | none (non-pod)

EMIT_JSON=0
[ "${1:-}" = "--json" ] && EMIT_JSON=1

if [ "$EMIT_JSON" -eq 1 ]; then
  case "$AUTO_STATE" in
    on)  fa=true ;;
    off) fa=false ;;
    *)   fa=null ;;
  esac
  queue_json='[]'
  if [ -d "$QUEUE_DIR" ]; then
    queue_json="$(find "$QUEUE_DIR" -maxdepth 1 -type f -name '*.json' -exec basename {} \; \
      | sort | jq -R . | jq -s .)"
  fi
  jq -n \
    --argjson workers "$WORKERS_JSON" \
    --argjson queue "$queue_json" \
    --arg inbox "$INBOX_ROOT" \
    --arg pod "$CURRENT_POD" \
    --argjson fa "$fa" \
    '{workers: [$workers.workers[]? | select(.tmux_session==$pod)],
      queue_files: $queue, inbox_root: $inbox, pod:$pod, full_auto: $fa}'
  exit 0
fi

# the pod's FULL AUTO switch (pod-auto / the strip's ⚡ pill); hidden for non-pods
case "$AUTO_STATE" in
  on)  echo " mode: ⚡ FULL AUTO — the manager dispatches autonomously (pod: ${CURRENT_POD})" ;;
  off) echo " mode: ✋ MANUAL — automatic dispatch disabled (pod-auto on to flip)" ;;
esac
echo "================================================================"
echo " WORKERS"
echo "================================================================"
# Both readers keep a fallback: a row missing .status (or any shape the filter can't
# add to a string) makes jq exit non-zero, and this is a REPORTER — one malformed row
# must degrade its own section, not abort the queue and completions sections below it.
printf '%s' "$WORKERS_JSON" | jq -r --arg pod "$CURRENT_POD" '.workers[] | select(.tmux_session==$pod)
  | "  " + (.tmux_window // "?") + " " + (.color // "") + " [" + (.label // "—") + "] " + .status + (if .current_task_id then " · " + .current_task_id else "" end) + (if .started_at then " · started " + .started_at else "" end)' || true
[ "$(printf '%s' "$WORKERS_JSON" | jq --arg pod "$CURRENT_POD" '[.workers[]|select(.tmux_session==$pod)] | length' 2>/dev/null || echo 0)" -eq 0 ] && echo "  (no workers registered — spawn one via the + button or pod-add-worker)"

echo ""
echo "================================================================"
echo " QUEUE (highest priority / earliest first)"
echo "================================================================"
queue_files=""
[ ! -d "$QUEUE_DIR" ] || queue_files="$(find "$QUEUE_DIR" -maxdepth 1 -type f -name '*.json' -exec basename {} \; | sort)"
if [ -z "$queue_files" ]; then
  echo "  (queue empty)"
else
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    fp="${QUEUE_DIR}/${f}"
    tid=$(jq -r .task_id "$fp")
    pri=$(jq -r .priority "$fp")
    desc=$(jq -r '.description // ""' "$fp")
    tpl=$(jq -r '.template // ""' "$fp")
    printf "  pri=%-3s %-40s %-15s %s\n" "$pri" "$tid" "[$tpl]" "$desc"
  done <<< "$queue_files"
fi

echo ""
echo "================================================================"
echo " RECENT COMPLETIONS (last 10)"
echo "================================================================"
if [ -s "$LOG_PATH" ]; then
  jq -c --arg pod "$CURRENT_POD" 'select(.event=="completed" and .pod==$pod)' \
    "$LOG_PATH" 2>/dev/null | tail -10 | jq -r '"  \(.ts)  \(.task_id)"'
else
  echo "  (no completions logged yet)"
fi

echo ""
archive_count=0
if [ -d "$DISPATCHED" ]; then
  archive_count="$(find "$DISPATCHED" -maxdepth 1 -type f -name '*.json' | wc -l | tr -d ' ')"
fi
echo "================================================================"
echo " DISPATCHED ARCHIVE COUNT: $archive_count"
echo "================================================================"
