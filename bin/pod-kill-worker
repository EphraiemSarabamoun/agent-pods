#!/usr/bin/env bash
# pod-kill-worker <window_id|name|kill_<window_id>> — terminate a pod worker.
#
# The inverse of pod-add-worker: kills the worker's tmux window (which terminates
# the agent process running in it) and removes it from the worker registry
# (workers.json). Wired to the clickable red "x" on each window tab by pod-launch;
# also runnable by hand (`pod-kill-worker Steve`).
#
# Refuses to kill window 0 (the manager / home base). Idempotent + defensive:
# no-op if the target window or the registry is absent. bash 3.2 safe.
set -uo pipefail
POD_BIN="$(cd "$(dirname "$0")" && pwd)"; . "$POD_BIN/_pod-paths.sh"; . "$POD_BIN/_pod-common.sh"
T="$POD_TMUX"
S="${POD_SESSION:-$POD_SESSION_PREFIX}"
WORKERS="$POD_STATE/workers.json"

arg="${1:-}"
win="${arg#kill_}"                       # accept the click range form "kill_@7" or a bare id/name
[ -n "$win" ] || { echo "usage: pod-kill-worker <window_id|name>"; exit 1; }

# Prefer the calling pane's live session over an inherited POD_SESSION, which becomes
# stale after a pod rename.
if [ -n "${TMUX_PANE:-}" ]; then
  live_session="$("$T" display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)"
  [ -n "$live_session" ] && S="$live_session"
fi

# resolve a window NAME to its id (so `pod-kill-worker Steve` works)
case "$win" in
  @*) : ;;
  *)
    resolved="$("$T" list-windows -t "$S" -F '#{window_id}|#{window_name}' 2>/dev/null \
                | awk -F'|' -v n="$win" '$2==n{print $1; exit}')"
    [ -n "$resolved" ] && win="$resolved" ;;
esac

# the window must exist
widx="$("$T" display-message -p -t "$win" '#{window_index}' 2>/dev/null || echo '')"
[ -n "$widx" ] || { echo "pod-kill-worker: no such window '$win' in pod '$S'"; exit 1; }

# Window ids are server-global. Never let a raw @id reach a sibling pod.
wsess="$("$T" display-message -p -t "$win" '#{session_name}' 2>/dev/null || true)"
if [ "$wsess" != "$S" ]; then
  echo "pod-kill-worker: refusing cross-pod target '$win' (caller=$S, target=${wsess:-unknown})" >&2
  exit 1
fi

# never kill the manager (window index 0)
if [ "$widx" = "0" ]; then
  echo "pod-kill-worker: refusing to terminate the manager (window 0)"
  exit 1
fi

wname="$("$T" display-message -p -t "$win" '#{window_name}' 2>/dev/null || echo "$win")"
worker_snapshot=""
[ ! -f "$WORKERS" ] || worker_snapshot="$(jq -c --arg tw "$win" --arg pod "$S" \
  'first(.workers[] | select(.tmux_window==$tw and .tmux_session==$pod)) // empty' \
  "$WORKERS" 2>/dev/null || true)"

# An assignment check followed by an unconditional drop has a TOCTOU hole: a
# dispatcher can claim the worker between those operations. Make the check+drop one
# locked compare-and-delete instead. Once this succeeds, no later dispatcher can
# claim the absent row, so killing the window cannot orphan a task.
if [ -f "$WORKERS" ]; then
  drop_err="$(mktemp "${POD_STATE}/.kill-worker.XXXXXX")" || exit 1
  if ! "$POD_BIN/pod-workers-json" --path "$WORKERS" \
      drop-if-unassigned "$win" "$S" 2>"$drop_err"; then
    detail="$(cat "$drop_err" 2>/dev/null || true)"
    rm -f "$drop_err"
    "$T" display-message -d 5000 -t "$S" \
      "Cannot close $wname: it has an assigned task (run mgr-poll after it finishes)" \
      2>/dev/null || true
    echo "${detail:-pod-kill-worker: registry update failed}; refusing to orphan $S/$win" >&2
    exit 1
  fi
  rm -f "$drop_err"
fi

# kill the window LAST (this SIGHUPs the pane, ending the agent process in it)
if ! "$T" kill-window -t "$win" 2>/dev/null; then
  # The locked delete made the row temporarily undispatchable. If tmux refused
  # the actual kill, restore the exact snapshot so a live worker is never orphaned
  # from the registry.
  [ -z "$worker_snapshot" ] || "$POD_BIN/pod-workers-json" --path "$WORKERS" \
    register "$worker_snapshot" >/dev/null 2>&1 || true
  echo "pod-kill-worker: tmux refused to terminate $S/$win; registry restored" >&2
  exit 1
fi

# log only after the window actually died. Resolve the pod from the target itself,
# not an inherited POD_SESSION from another pod.
CHAN="$(pod_chan_for "$wsess")"; mkdir -p "$(dirname "$CHAN")"
echo "[$(date +%H:%M)] (system): terminated pod agent $wname ($win)" >> "$CHAN" 2>/dev/null || true
echo "terminated $wname ($win)"
