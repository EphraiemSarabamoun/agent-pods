#!/usr/bin/env bash
# pod-deliver <window_id> [--mode none|buffer|submit] [--dry-run] — surface unread
# pod-mail to an agent that has NO lifecycle hooks (codex, cursor, a shell, ...), by
# typing a one-line notification into its pane with tmux send-keys.
#
# This is what makes pod-comms universal: hook-capable agents (Claude Code) get mail
# injected as additionalContext by their own hook and are SKIPPED here; everyone else
# gets the floor — a send-keys notification, delivered only when it's safe.
#
# Delivery mode (auto-resolved per recipient, override with --mode):
#   none    @pod_native_delivery=1 -> the agent surfaces mail itself; do nothing.
#   buffer  type the line, do NOT press Enter (a plain shell: visible at the prompt,
#           never executed). Safe but the recipient won't "act" until a human submits.
#   submit  type the line AND press Enter (an idle AI agent at its prompt gets a turn).
#           Default for AI poll-agents; gated hard (see below). Set POD_DELIVER_SUBMIT=0
#           to force every agent to buffer mode (most conservative).
#
# SAFETY GATES (all must pass for submit; buffer skips the settle re-check):
#   1. non-empty window id            (EMPTY-TARGET FOOTGUN: blank -t hits the ACTIVE window)
#   2. recipient @cc_state == idle    (never interrupt a working agent)
#   3. pane not in a full-screen app  (vim/less/man/... would eat the keystrokes as commands)
#   4. (submit only) the pane is settled across a 0.4s re-check (nobody is typing right now)
#   5. (submit only, ON BY DEFAULT) the adapter proves the LAST visible input line is
#      its empty placeholder; a stable human draft is never sufficient — it sits
#      unchanged indefinitely and gate 4 passes over it trivially. An adapter with no
#      prompt_line_regex/empty_prompt_regex cannot supply that proof, so it drops to
#      buffer mode rather than risk submitting whatever the human left in the box.
#      POD_DELIVER_REQUIRE_EMPTY=0 restores the old settle-check-only behavior.
#   6. NEVER send Enter in buffer mode -> a clobber is at worst editable text, never a run.
#
# Notifies once per batch of unread lines via a per-mailbox high-water mark, so the
# poller calling this every cycle doesn't re-ping the same mail. bash 3.2 safe.
set -u
POD_BIN="$(cd "$(dirname "$0")" && pwd)"; . "$POD_BIN/_pod-paths.sh"; . "$POD_BIN/_pod-common.sh"
T="$POD_TMUX"

win=""; mode=""; dry=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode)
      [ "$#" -ge 2 ] || { echo "pod-deliver: --mode requires a value" >&2; exit 2; }
      mode="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    @*|[0-9]*) win="$1"; shift ;;
    *) shift ;;
  esac
done
[ -n "$win" ] || { echo "usage: pod-deliver <window_id> [--mode ...] [--dry-run]" >&2; exit 1; }   # gate 1

# resolve recipient pod + mailbox (the recipient's OWN pod, from the window's session).
sess="$("$T" display-message -p -t "$win" '#{session_name}' 2>/dev/null)"
[ -n "$sess" ] || exit 0
maildir="$(pod_dir_for "$sess")"
mbox="$maildir/${win}.mbox"
hwf="$maildir/${win}.hw"
if [ ! -f "$mbox" ]; then
  # A drain (pod-mail / pod-mail-check) renames the mailbox ASIDE and deletes it, so
  # after a read the mbox is ABSENT, not empty — the `count -eq 0` reset below is
  # unreachable. Leaving the high-water at the drained batch's line count silently
  # swallows every later batch that is no bigger than it: the single-message case is
  # then never notified again, forever, for that window.
  rm -f "$hwf" 2>/dev/null || true
  exit 0
fi

# Claim this mailbox before reading the high-water. pod-tell fires a deliver the
# instant it appends and the ~3s poller fires another; the high-water is read here but
# only written after send-keys (plus a settle in submit mode), so both racers see the
# same stale value, both type the note, and both press Enter — one garbled turn plus
# one empty submission. mkdir is the atomic primitive available on macOS (no flock).
dlock="$maildir/${win}.dlock"
if ! mkdir "$dlock" 2>/dev/null; then
  # A killed deliver can leave the lock behind; a live one holds it for well under a
  # second, so only an old lock is stealable — and steal by atomic rename so two
  # stealers cannot remove a freshly-acquired replacement.
  lock_age=$(( $(date +%s) - $(pod_file_mtime "$dlock") ))
  [ "$lock_age" -gt 30 ] || exit 0
  stale="$dlock.stale.$$"
  mv "$dlock" "$stale" 2>/dev/null && rmdir "$stale" 2>/dev/null
  mkdir "$dlock" 2>/dev/null || exit 0
fi
trap 'rmdir "$dlock" 2>/dev/null || true' EXIT
trap 'exit 0' INT TERM

# how many lines are unread vs already-notified (high-water).
count="$(awk 'END{print NR+0}' "$mbox" 2>/dev/null || echo 0)"
hw="$(cat "$hwf" 2>/dev/null || echo 0)"
case "$hw" in ''|*[!0-9]*) hw=0 ;; esac
if [ "$count" -eq 0 ]; then printf '0' > "$hwf" 2>/dev/null || true; exit 0; fi   # truncated in place
if [ "$count" -lt "$hw" ]; then hw=0; fi                                           # shrank -> reset
[ "$count" -gt "$hw" ] || exit 0                                                   # nothing new

# Resolve the adapter even when the caller forced a mode: the stricter FULL AUTO
# path also needs its agent-specific empty-prompt proof.
aid="$("$T" show-options -wqv -t "$win" @agent_id 2>/dev/null)"
[ -n "$aid" ] || aid="$("$POD_BIN/pod-detect" "$win" 2>/dev/null)"

# resolve delivery mode if not forced.
if [ -z "$mode" ]; then
  nd="$("$T" show-options -wqv -t "$win" @pod_native_delivery 2>/dev/null)"
  if [ "$nd" = "1" ]; then
    mode="none"
  else
    adv="$("$POD_ADAPTER" field "$aid" deliver 2>/dev/null || true)"   # optional adapter override
    if [ -n "$adv" ]; then mode="$adv"
    elif [ "$aid" = "generic-shell" ]; then mode="buffer"
    else mode="submit"; fi
  fi
fi
[ "${POD_DELIVER_SUBMIT:-1}" = "0" ] && [ "$mode" = "submit" ] && mode="buffer"
[ "$mode" = "none" ] && { printf '%s' "$count" > "$hwf" 2>/dev/null || true; exit 0; }

# gate 5, resolved BEFORE we commit to submit. A stable pane is NOT proof that its
# input buffer is empty — a human draft can sit unchanged indefinitely, and pressing
# Enter over one SUBMITS it. Only an adapter that can point at its own empty prompt
# line can tell the two apart, so an agent without those regexes drops to buffer
# (type it, never Enter) instead of gambling. Set POD_DELIVER_REQUIRE_EMPTY=0 to go
# back to trusting the settle check alone.
require_empty="${POD_DELIVER_REQUIRE_EMPTY:-1}"
prompt_re=""; empty_re=""
if [ "$mode" = "submit" ] && [ "$require_empty" = "1" ]; then
  prompt_re="$("$POD_ADAPTER" field "$aid" prompt_line_regex 2>/dev/null || true)"
  empty_re="$("$POD_ADAPTER" field "$aid" empty_prompt_regex 2>/dev/null || true)"
  { [ -n "$prompt_re" ] && [ -n "$empty_re" ]; } || mode="buffer"
fi

# gate 2: only deliver to an idle recipient.
st="$("$T" show-options -wqv -t "$win" @cc_state 2>/dev/null)"
[ "$st" = "idle" ] || exit 0

# gate 3: don't type into a full-screen program (it would interpret keystrokes).
pcmd="$("$T" display-message -p -t "$win" '#{pane_current_command}' 2>/dev/null)"
case "$pcmd" in
  vi|vim|nvim|view|less|more|most|man|emacs|nano|pico|micro|htop|top|atop|btop|watch|fzf|git) exit 0 ;;
esac

# build the one-line notification from the NEW (un-notified) mailbox lines.
newcnt=$(( count - hw ))
last="$(awk -v s="$hw" 'NR>s{l=$0} END{print l}' "$mbox" 2>/dev/null)"
last="$(printf '%s' "$last" | tr '\n\r\t' '   ' | cut -c1-200)"
if [ "$newcnt" -gt 1 ]; then
  note="[pod-mail] $newcnt new. latest: $last  (run pod-mail to read all)"
else
  note="[pod-mail] $last  (run pod-mail to read all)"
fi

if [ "$dry" = "1" ]; then
  echo "would deliver (mode=$mode) to $win: $note"
  exit 0
fi

# gate 4 (submit only): make sure nobody is actively typing/streaming right now.
if [ "$mode" = "submit" ]; then
  screen1="$("$T" capture-pane -p -J -t "$win" 2>/dev/null)"
  h1="$(printf '%s' "$screen1" | cksum | awk '{print $1}')"
  if [ "$require_empty" = "1" ]; then
    printf '%s' "$screen1" | python3 -c '
import re, sys
prompt, empty = sys.argv[1:3]
lines = [line.rstrip("\r") for line in sys.stdin.read().splitlines()]
candidates = [line for line in lines if re.search(prompt, line)]
raise SystemExit(0 if candidates and re.fullmatch(empty, candidates[-1]) else 1)
' "$prompt_re" "$empty_re" || exit 0
  fi
  sleep 0.4
  screen2="$("$T" capture-pane -p -J -t "$win" 2>/dev/null)"
  h2="$(printf '%s' "$screen2" | cksum | awk '{print $1}')"
  [ "$h1" = "$h2" ] || exit 0          # screen changed -> active -> retry next cycle
  if [ "$require_empty" = "1" ]; then
    printf '%s' "$screen2" | python3 -c '
import re, sys
prompt, empty = sys.argv[1:3]
lines = [line.rstrip("\r") for line in sys.stdin.read().splitlines()]
candidates = [line for line in lines if re.search(prompt, line)]
raise SystemExit(0 if candidates and re.fullmatch(empty, candidates[-1]) else 1)
' "$prompt_re" "$empty_re" || exit 0
  fi
fi

# deliver. -l = literal text (no key interpretation). gate 6: Enter ONLY in submit mode.
"$T" send-keys -t "$win" -l "$note" 2>/dev/null || exit 0
if [ "$mode" = "submit" ]; then
  sleep 0.15                            # let the literal text land before Enter (race guard)
  "$T" send-keys -t "$win" Enter 2>/dev/null || true
fi

printf '%s' "$count" > "$hwf" 2>/dev/null || true   # high-water: don't re-ping these lines
