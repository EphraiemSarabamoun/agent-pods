#!/usr/bin/env python3
# pod-spawn-menu-build [client] — open the pod "+" quick-pick as a native tmux
# display-menu, generated from the quick-pick slots file ($POD_SLOTS).
#
# Shows EXACTLY the 10 curated slots, keyed 0-9. Picking one runs pod-add-worker
# with that slot's resolved launch command. The slots are edited via the settings
# (gear) button -> pod-settings-menu; the universe of agents/models/efforts they
# draw from lives in the adapter catalog (queried via pod-adapter).
#
# A single FLAT menu, every item selectable (slot 0 is seeded, so the first /
# initially-highlighted item is always selectable -> no "starting choice invalid").
# Single-level (no nested display-menu) is deliberate — it dodges the deep
# quote-nesting and the run-shell client-context loss that bit earlier work.
#
# Set POD_MENU_PRINT=1 to print the tmux argv (one per line) instead of opening the
# menu — used to validate the generated command without popping a menu at someone.
import json
import os
import shlex
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
# Resolve from the environment (set by _pod-paths.sh), with repo-relative fallbacks.
POD_BIN = os.environ.get("POD_BIN") or HERE
POD_REPO = os.environ.get("POD_REPO") or os.path.dirname(POD_BIN)
SLOTS = os.environ.get("POD_SLOTS") or os.path.join(
    os.environ.get("POD_CONFIG_DIR", os.path.expanduser("~/.config/pod")), "slots.json"
)
ADD = os.path.join(POD_BIN, "pod-add-worker")
SETTINGS = os.path.join(POD_BIN, "pod-settings-menu")
ADAPTER = os.environ.get("POD_ADAPTER") or os.path.join(POD_BIN, "pod-adapter")
STATE = os.environ.get("POD_STATE") or os.path.join(
    os.environ.get(
        "POD_TMP",
        os.path.join(os.environ.get("TMPDIR", "/tmp"), f"agent-pods-{os.getuid()}"),
    ),
    "state",
)
# Prefer $POD_TMUX from env; else resolve on PATH (no hardcoded path).
TMUX = os.environ.get("POD_TMUX") or "tmux"

client = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else None


def adapter(*args):
    """Return adapter stdout, or None when the semantic selection is unavailable."""
    try:
        result = subprocess.run(
            [ADAPTER, *args], capture_output=True, text=True, timeout=40
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.rstrip("\n") if result.returncode == 0 else None


def notify(msg):
    """The ONLY channel back to the user: the "+" runs from a backgrounded run-shell,
    so a traceback (or a silent no-op) goes nowhere anyone will ever look."""
    if os.environ.get("POD_MENU_PRINT"):
        # POD_MENU_PRINT is a dry run whose whole point is not popping anything at a
        # live client; surface the text instead of firing it at someone's screen.
        sys.stderr.write("pod-spawn-menu-build: would notify: %s\n" % msg)
        return
    try:
        subprocess.run([TMUX, "display-message", "-d", "5000", msg], timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def provisional_slots():
    """Cheap, discovery-free defaults: one inherited-model slot per installed agent.

    Deliberately does NOT go near `pod-adapter models` (the live-discovery entry
    point). `list --available` is PATH + TOML only, and `field <id> label` is a raw
    TOML scalar read — unlike `card`, which resolves the adapter's default model and
    so CAN fall into discovery when that default is a concrete slug rather than
    "inherit". The label here is provisional anyway: the render loop below replaces it
    with the resolved card. This is the same shape install.sh writes, which is why an
    installed setup never paid for the richer seed either.
    """
    out = []
    for aid in (adapter("list", "--available") or "").splitlines():
        aid = aid.strip()
        if not aid:
            continue
        out.append({"agent": aid, "model": "", "effort": "",
                    "label": adapter("field", aid, "label") or aid})
    return out[:10]


def seed_in_background():
    """Kick the discovery-backed seeder OFF the click path.

    Seeding inline ran live discovery for every installed agent serially, so the first
    "+" press on a fresh setup sat dead for ~47s with no spinner and no message. The
    mkdir lock matters because a button that looks dead gets clicked again and again,
    and each click used to start another full discovery sweep.
    """
    lock = os.path.join(STATE, "seed-slots.lock")
    try:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        try:
            os.mkdir(lock)
        except FileExistsError:
            # A seeder that died leaves the lock behind; let a new one through once
            # the marker is older than any run could plausibly still be.
            if time.time() - os.stat(lock).st_mtime < 300:
                return
            os.utime(lock, None)
        subprocess.Popen([os.path.join(POD_BIN, "pod-seed-slots")],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


# Self-heal: on a fresh setup the slots file doesn't exist yet (it's normally written
# by the gear/settings menu). Render from the cheap declared defaults NOW and let the
# seeder fill in the richer, discovery-backed slots for the next open. The old code
# ran the seeder inline and then opened the file BLIND, so a seeder that wrote nothing
# (empty catalog, python < 3.11, read-only $POD_CONFIG_DIR) turned the pod's primary
# spawn affordance into a silent FileNotFoundError with no diagnostic anywhere.
data = None
try:
    with open(SLOTS) as f:
        data = json.load(f)
except (OSError, ValueError):
    data = None

title = data.get("title") if isinstance(data, dict) else None
raw = data.get("slots") if isinstance(data, dict) else None
# Non-dict entries can only come from a hand-edited slots.json, and one of them must
# not be able to take the whole picker down with an AttributeError.
slots = [s for s in raw if isinstance(s, dict)][:10] if isinstance(raw, list) else []

if not slots:
    if not os.environ.get("POD_MENU_PRINT"):   # POD_MENU_PRINT is a dry run
        seed_in_background()
    slots = provisional_slots()
    if not slots:
        notify("pod: no agents found on PATH — run `pod-doctor`. Falling back to a shell.")
        slots = [{"agent": "generic-shell", "label": "Shell"}]

data = {"title": title or "Spawn agent (0-9)", "slots": slots}

# NO -c: tmux resolves the current client automatically here, exactly like the ✕
# button's `tmux confirm-before` does from the same backgrounded run-shell context.
# Passing -c "<#{client_name} tty>" made display-menu return 1.
argv = [TMUX, "display-menu", "-T", data.get("title", "Spawn agent (0-9)")]
_ = client  # accepted for compat; intentionally unused (see note above)

for i, s in enumerate(slots):
    key = str(i)  # 0-9, the slot index doubles as the mnemonic
    saved_label = s.get("label") or "(empty)"
    label = saved_label
    cmd = s.get("cmd", "")
    agent = s.get("agent", "")
    if agent or cmd:
        # Known agents are resolved when the menu OPENS and again when the item is
        # clicked. Both the visible label and launched seat therefore follow the
        # models offered by the locally installed agent; a stale saved model becomes
        # "inherit" and cannot leave an old model name on the tab. A command-only
        # legacy/custom slot keeps its explicit command and label. shlex.join/quote
        # makes every catalog value literal.
        spawn = [ADD]
        if agent:
            model = adapter("resolve-model", agent, s.get("model", ""))
            if model is None:
                model = s.get("model", "")
            effort = adapter("resolve-effort", agent, model, s.get("effort", ""))
            if effort is None:
                effort = ""
            card_args = ["card", agent]
            if model:
                card_args += ["--model", model]
            if effort:
                card_args += ["--effort", effort]
            current_label = adapter(*card_args)
            # `card` falls back to echoing the bare id for an agent the catalog can no
            # longer resolve (unreadable adapters dir, python < 3.11). Keep the slot's
            # saved label in that case, so a degraded menu still reads "Shell" rather
            # than "generic-shell".
            if current_label and current_label != agent:
                label = current_label
            spawn += ["--agent", agent]
            if model:
                spawn += ["--model", model]
            if effort:
                spawn += ["--effort", effort]
        else:
            spawn += ["--cmd", cmd]
            spawn += ["--label", saved_label]
        item = "run-shell -b " + shlex.quote(shlex.join(spawn))
    else:
        # empty slot (shouldn't happen post-seed): clicking it jumps straight into
        # editing that slot via the settings drill-down.
        item = f"run-shell -b '{SETTINGS} --step agent --slot {i}'"
    argv += [f"{key}  ·  {label}", key, item]

if os.environ.get("POD_MENU_PRINT"):
    for a in argv:
        print(a)
    sys.exit(0)

# Run display-menu and log tmux's stderr + exit code, so a non-pop is debuggable.
log = os.path.join(STATE, "pod-spawn-menu.log")
os.makedirs(os.path.dirname(log), exist_ok=True)
with open(log, "a") as lf:
    lf.write("argv=%r\n" % (argv,))
    r = subprocess.run(argv, stderr=lf)
    lf.write("exit=%d\n" % r.returncode)
sys.exit(r.returncode)
